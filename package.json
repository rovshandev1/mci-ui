		"type": "git",
		"url": "git+https://github.com/rovshandev1/mci-ui.git"
	},
	"bugs": {
		"url": "https://github.com/rovshandev1/mci-ui/issues"
	},
	"homepage": "https://github.com/rovshandev1/mci-ui#readme"
