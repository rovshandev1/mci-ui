{
   "semi": false,
   "singleQuote": true,
   "tabWidth": 3,
   "trailingComma": "es5",
   "printWidth": 100,
   "bracketSpacing": true,
   "arrowParens": "always",
   "endOfLine": "lf",
   "plugins": ["prettier-plugin-tailwindcss"],
   "tailwindFunctions": ["cn", "clsx", "twMerge"],
   "tailwindPreserveDuplicates": true,
   "tailwindStylesheet": "./src/index.css"
}
